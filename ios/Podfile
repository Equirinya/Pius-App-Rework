# Must match IPHONEOS_DEPLOYMENT_TARGET in Runner.xcodeproj, otherwise the pods
# are built against a different minimum than the app. 13.0 is the floor imposed
# by the dependencies: mobile_scanner >= 7.1 and share_plus >= 13 both require
# iOS 13, as do current Flutter versions.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # :linkage => :static is required by background_fetch: its TSBackgroundFetch.xcframework
  # is a statically linked binary, and plain `use_frameworks!` (dynamic) makes CocoaPods
  # abort with "target has transitive dependencies that include statically linked binaries".
  # See https://fetch.transistorsoft.com/flutter/setup/
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Isar erreicht seinen nativen Core über Dart-FFI und sucht die Symbole zur
  # Laufzeit mit `DynamicLibrary.process()` - also über den Symbolnamen im
  # fertigen App-Binary, nicht über eine Referenz, die der Linker sehen kann.
  #
  # Seit `use_frameworks! :linkage => :static` (siehe oben) landet alles im
  # Runner-Binary, und im Release-Build entfernen Dead-Code-Stripping und
  # `strip` genau die Symbole, die von nirgendwo referenziert werden. Ergebnis:
  # `Isar.open()` wirft "Invalid argument(s): Failed to lookup symbol 'isar_...'",
  # im Debug-Build fällt das nicht auf, in TestFlight kam die App nicht mehr hoch.
  # Vgl. https://github.com/isar/isar/issues/1072 und .../issues/1330
  #
  # Falls der Startbildschirm einen anderen Fehler zeigt als einen
  # Symbol-Lookup, kann dieser Block wieder raus.
  #
  # Alternative, falls das nicht reicht: global wieder auf dynamisches
  # `use_frameworks!` zurück und nur background_fetch per pre_install-Hook auf
  # static_library zwingen - dann bleibt der Rest der Pods unverändert.
  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    next if user_project.nil?

    user_project.native_targets.each do |target|
      next unless target.name == 'Runner'

      target.build_configurations.each do |config|
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        config.build_settings['STRIP_STYLE'] = 'debugging'
      end
    end

    user_project.save
  end
end
